# Container for running older Vivado releases (<= 2021.2) on Apple Silicon.
#
# AMD only supports these releases on Ubuntu 16.04/18.04 (2019.2) and up to
# Ubuntu 20.04 (2021.x), so the main Dockerfile (Ubuntu 24.04) cannot be used
# for them. This legacy image is selected automatically by gen_image.sh when a
# Vivado version <= 2021.2 is being installed; it is not tested as thoroughly
# as the main image.
FROM --platform=linux/amd64 ubuntu:20.04

ARG DEBIAN_FRONTEND=noninteractive

# Install everything in one layer and keep the image small.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg sudo nano \
        dbus dbus-x11 x11-utils xorg xvfb net-tools \
        libgl1-mesa-dri mesa-utils \
        lxde lxappearance lxterminal xterm arc-theme \
        gtk2-engines gtk2-engines-murrine gtk2-engines-pixbuf \
        fonts-droid-fallback gnome-themes-standard ubuntu-gnome-default-settings \
        alsa-utils \
        python3-pip python3-dev build-essential git \
        gcc-multilib g++ \
        ocl-icd-opencl-dev libjpeg62-dev libc6-dev-i386 \
        graphviz make unzip \
        libtinfo5 libncurses5 libncursesw5 libjpeg62 libssl1.1 libswt-gtk-4-jni \
        locales \
        # tigervnc-common is only a Recommends of the server package; it is
        # installed explicitly because it provides tigervncpasswd/vncpasswd.
        tigervnc-common tigervnc-standalone-server tigervnc-xorg-extension \
        x11-xserver-utils xfonts-base \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# tigervnc-common in Ubuntu 20.04 normally provides /usr/bin/vncpasswd through
# update-alternatives; keep a symlink fallback in case it is missing.
RUN if [ ! -e /usr/bin/vncpasswd ]; then ln -sf /usr/bin/tigervncpasswd /usr/bin/vncpasswd; fi

# Create user "user" with password "password" (the VNC connection is local-only).
RUN useradd --create-home --shell /bin/bash --user-group --groups adm,sudo user && \
    echo "user:password" | chpasswd && \
    chown -R user:user /home/user

# Setup LXDE desktop configuration
RUN mkdir -p /home/user/.config/pcmanfm/LXDE/ && \
    if [ -f /usr/local/share/doro-lxde-wallpapers/desktop-items-0.conf ]; then \
        ln -sf /usr/local/share/doro-lxde-wallpapers/desktop-items-0.conf \
               /home/user/.config/pcmanfm/LXDE/; \
    fi && \
    if [ -f /usr/bin/lxpolkit ]; then mv /usr/bin/lxpolkit /usr/bin/lxpolkit.bak; fi

# Setup TigerVNC (Ubuntu 20.04 calls the session file Xvnc-session)
RUN if [ -f /etc/X11/Xtigervnc-session ]; then \
        sed -i 's/-iconic/-nowin/g' /etc/X11/Xtigervnc-session; \
    else \
        sed -i 's/-iconic/-nowin/g' /etc/X11/Xvnc-session; \
    fi && \
    mkdir -p /home/user/.vnc && \
    echo "password" | vncpasswd -f > /vncpasswd && \
    chown user /vncpasswd && \
    chmod 600 /vncpasswd

# Generate locale — Vivado crashes at startup without en_US.UTF-8
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Keep the Java heap of the installer/Vivado bounded, like the main image.
ENV JAVA_TOOL_OPTIONS="-Xmx4096m -Xms512m"

# Without this, Vivado can crash when synthesizing. Ubuntu 20.04 keeps GTK2's
# libgdk in /usr/lib; de_start.sh also resolves it dynamically.
ENV LD_PRELOAD="/lib/x86_64-linux-gnu/libudev.so.1 /lib/x86_64-linux-gnu/libselinux.so.1 /lib/x86_64-linux-gnu/libz.so.1 /usr/lib/x86_64-linux-gnu/libgdk-x11-2.0.so.0"
